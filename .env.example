# Chat Ships It — copy to .env.local (never commit)

# Demo mode (default): mock Twitch auth + template widgets
DEMO_MODE=true

# Optional: real OpenAI key for /api/build live widget generation (server-side only)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: real Twitch app (dev.twitch.tv/console). Without these, DEMO_MODE auth is used.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional bot / broadcaster for EventSub worker (see docs/WORKER.md)
# TWITCH_BOT_USER_ID=
# TWITCH_BROADCASTER_USER_ID=
# TWITCH_BOT_TOKEN=
# TWITCH_BROADCASTER_TOKEN=
